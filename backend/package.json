{
  "name": "hr-management-backend",
  "version": "1.0.0",
  "description": "Commercial multi-company HR management backend",
  "type": "module",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit",
    "db:test": "tsx src/database/test-connection.ts"
